<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>基本设置</string>
			<key>footerText</key>
			<string>插件不渲染任何图层：把 .tendies 装进系统海报库，动画交给 PosterBoard 原生播放。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.axs.tendiesx</string>
			<key>key</key>
			<string>Enabled</string>
			<key>label</key>
			<string>启用插件</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.axs.tendiesx</string>
			<key>key</key>
			<string>AutoApply</string>
			<key>label</key>
			<string>安装后自动设为当前壁纸</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>素材</string>
			<key>footerText</key>
			<string>素材目录：/var/mobile/Library/TendiesX/（压缩包和已解包目录都行，也可用 Filza 直接丢进去；进入本页会实时重扫，不需要手动刷新）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>detail</key>
			<string>TXPackageListController</string>
			<key>id</key>
			<string>material</string>
			<key>label</key>
			<string>选择素材</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>素材操作</string>
			<key>footerText</key>
			<string>装完去「设置 → 墙纸 → 添加新墙纸 → 收藏」里选它；开了自动生效会直接替换当前壁纸并重启 PosterBoard 刷新收藏。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>安装选中的素材</string>
			<key>action</key>
			<string>tx_installPoster:</string>
			<key>id</key>
			<string>install</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>清理重复壁纸</string>
			<key>action</key>
			<string>tx_cleanupDuplicates:</string>
			<key>id</key>
			<string>cleanup</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>从「文件」App 选择 .tendies</string>
			<key>action</key>
			<string>tx_pickFiles:</string>
			<key>id</key>
			<string>pick</string>
		</dict>
	</array>
	<key>title</key>
	<string>TendiesX</string>
</dict>
</plist>
